# Kopieer dit bestand naar .env en vul de SMTP-gegevens van je mailprovider in.
# Zonder deze gegevens draait de server in ontwikkelmodus: berichten worden
# alleen in de console gelogd, niet echt gemaild.

# Waar de aanvragen naartoe gaan
CONTACT_TO=rens@renergymovement.nl

# SMTP-instellingen (vraag op bij je mail-/hostingprovider)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Renergy Movement website <no-reply@renergymovement.nl>"

# Poort van de webserver
PORT=3000
